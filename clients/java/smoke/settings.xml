<?xml version="1.0" encoding="UTF-8"?>
<!-- The credentials of GitHub Packages for the registry smoke (pom.xml beside it): the run's actor and its own
     GITHUB_TOKEN (packages: read), read from the environment. GitHub Packages asks for a token even for a public
     package. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <servers>
    <server>
      <id>github</id>
      <username>${env.GITHUB_ACTOR}</username>
      <password>${env.GITHUB_TOKEN}</password>
    </server>
  </servers>
</settings>
